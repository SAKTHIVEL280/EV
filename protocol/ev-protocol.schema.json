{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SAKTHIVEL280/EV/blob/main/protocol/ev-protocol.schema.json",
  "title": "EvMessage",
  "description": "EV wire protocol between the Tauri app (Rust) and ev-core (Python). One JSON object per WebSocket text frame. Changes are additive; removing or renaming a field requires a protocol version bump.",
  "x-ev-protocol-version": 1,
  "oneOf": [
    {
      "$ref": "#/$defs/HelloMessage"
    },
    {
      "$ref": "#/$defs/HelloAckMessage"
    },
    {
      "$ref": "#/$defs/PingMessage"
    },
    {
      "$ref": "#/$defs/PongMessage"
    },
    {
      "$ref": "#/$defs/ErrorMessage"
    },
    {
      "$ref": "#/$defs/ShutdownMessage"
    },
    {
      "$ref": "#/$defs/ChatSendMessage"
    },
    {
      "$ref": "#/$defs/ChatCancelMessage"
    },
    {
      "$ref": "#/$defs/ChatResetMessage"
    },
    {
      "$ref": "#/$defs/ChatStartedMessage"
    },
    {
      "$ref": "#/$defs/ChatDeltaMessage"
    },
    {
      "$ref": "#/$defs/ChatToolMessage"
    },
    {
      "$ref": "#/$defs/ChatDoneMessage"
    },
    {
      "$ref": "#/$defs/ChatFailedMessage"
    },
    {
      "$ref": "#/$defs/LlmStatusMessage"
    },
    {
      "$ref": "#/$defs/ConfigGetMessage"
    },
    {
      "$ref": "#/$defs/ConfigSetMessage"
    },
    {
      "$ref": "#/$defs/ConfigResetMessage"
    },
    {
      "$ref": "#/$defs/ConfigStateMessage"
    },
    {
      "$ref": "#/$defs/ConfigRejectedMessage"
    },
    {
      "$ref": "#/$defs/ModelsGetMessage"
    },
    {
      "$ref": "#/$defs/ModelsDownloadMessage"
    },
    {
      "$ref": "#/$defs/ModelsCancelMessage"
    },
    {
      "$ref": "#/$defs/ModelsStateMessage"
    },
    {
      "$ref": "#/$defs/ToolConfirmMessage"
    },
    {
      "$ref": "#/$defs/ToolAnswerMessage"
    },
    {
      "$ref": "#/$defs/ToolConfirmClosedMessage"
    },
    {
      "$ref": "#/$defs/ActionRecordedMessage"
    },
    {
      "$ref": "#/$defs/ActionUndoMessage"
    },
    {
      "$ref": "#/$defs/ActionUndoneMessage"
    },
    {
      "$ref": "#/$defs/TimerFiredMessage"
    },
    {
      "$ref": "#/$defs/FocusChangedMessage"
    }
  ],
  "$defs": {
    "ProtocolVersion": {
      "description": "Protocol version of the sender. Receivers compare it with their own and reply with an error of code protocol_mismatch when they differ.",
      "type": "integer",
      "minimum": 1
    },
    "MessageId": {
      "description": "UUID v4, unique per message.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Version": {
      "description": "Semantic version string of a component.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "ModuleState": {
      "type": "string",
      "enum": [
        "starting",
        "ready",
        "disabled",
        "failed"
      ]
    },
    "ModuleStatus": {
      "type": "object",
      "required": [
        "name",
        "state"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "state": {
          "$ref": "#/$defs/ModuleState"
        },
        "detail": {
          "description": "User-facing explanation when state is disabled or failed.",
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "HelloPayload": {
      "type": "object",
      "required": [
        "app_version",
        "protocol"
      ],
      "properties": {
        "app_version": {
          "$ref": "#/$defs/Version"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion"
        }
      }
    },
    "HelloAckPayload": {
      "type": "object",
      "required": [
        "core_version",
        "protocol",
        "modules"
      ],
      "properties": {
        "core_version": {
          "$ref": "#/$defs/Version"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleStatus"
          }
        }
      }
    },
    "EmptyPayload": {
      "type": "object"
    },
    "ErrorPayload": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "description": "Stable machine-readable code. New codes may be added; receivers treat unknown codes as internal.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "message": {
          "description": "Short, plain, user-facing text.",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "detail": {
          "description": "Technical detail for logs. Never shown in the island.",
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "ShutdownPayload": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "app_exit",
            "restart"
          ]
        }
      }
    },
    "HelloMessage": {
      "description": "Rust -> core. First message after the WebSocket opens.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "hello"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/HelloPayload"
        }
      }
    },
    "HelloAckMessage": {
      "description": "core -> Rust. Answer to hello.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "hello.ack"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/HelloAckPayload"
        }
      }
    },
    "PingMessage": {
      "description": "Rust -> core. Liveness check, sent every 5 s.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "ping"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/EmptyPayload"
        }
      }
    },
    "PongMessage": {
      "description": "core -> Rust. Answer to ping; reply_to carries the ping id.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "pong"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/EmptyPayload"
        }
      }
    },
    "ErrorMessage": {
      "description": "Either direction. reply_to carries the id of the message that caused it, when known.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "error"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/ErrorPayload"
        }
      }
    },
    "ShutdownMessage": {
      "description": "Rust -> core. Core stops modules, closes the socket and exits with code 0.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "shutdown"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/ShutdownPayload"
        }
      }
    },
    "Effort": {
      "description": "Effort level (CLAUDE.md §5.5).",
      "type": "string",
      "enum": [
        "instant",
        "normal",
        "deep",
        "max"
      ]
    },
    "TurnId": {
      "description": "The id of the chat.send message that started the turn.",
      "$ref": "#/$defs/MessageId"
    },
    "ModelName": {
      "description": "Model file name, as configured.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "Millis": {
      "type": "integer",
      "minimum": 0
    },
    "ChatSendPayload": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "description": "User input. Core refuses text over its own limit with chat.failed.",
          "type": "string",
          "maxLength": 100000
        },
        "effort": {
          "description": "Requested effort; omitted means the configured default.",
          "$ref": "#/$defs/Effort"
        }
      }
    },
    "ChatCancelPayload": {
      "type": "object",
      "required": [
        "turn_id"
      ],
      "properties": {
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        }
      }
    },
    "ChatStartedPayload": {
      "type": "object",
      "required": [
        "turn_id",
        "effort"
      ],
      "properties": {
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "effort": {
          "$ref": "#/$defs/Effort"
        },
        "model": {
          "description": "Absent when the rule router answers without a model.",
          "$ref": "#/$defs/ModelName"
        }
      }
    },
    "ChatDeltaPayload": {
      "type": "object",
      "required": [
        "turn_id",
        "text"
      ],
      "properties": {
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "text": {
          "description": "Next piece of the reply.",
          "type": "string"
        }
      }
    },
    "ChatToolState": {
      "type": "string",
      "enum": [
        "running",
        "done",
        "failed",
        "blocked",
        "asking",
        "declined"
      ]
    },
    "ChatToolPayload": {
      "type": "object",
      "required": [
        "turn_id",
        "name",
        "state"
      ],
      "properties": {
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "state": {
          "$ref": "#/$defs/ChatToolState"
        }
      }
    },
    "ChatTimings": {
      "type": "object",
      "required": [
        "total_ms"
      ],
      "properties": {
        "first_token_ms": {
          "description": "Request received to first reply token.",
          "$ref": "#/$defs/Millis"
        },
        "total_ms": {
          "$ref": "#/$defs/Millis"
        },
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "generated_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ChatDonePayload": {
      "type": "object",
      "required": [
        "turn_id",
        "text",
        "effort",
        "timings",
        "cancelled"
      ],
      "properties": {
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "text": {
          "description": "The full reply.",
          "type": "string"
        },
        "effort": {
          "$ref": "#/$defs/Effort"
        },
        "model": {
          "$ref": "#/$defs/ModelName"
        },
        "timings": {
          "$ref": "#/$defs/ChatTimings"
        },
        "cancelled": {
          "description": "True when a cancel or a newer message ended the turn early.",
          "type": "boolean"
        }
      }
    },
    "ChatFailedPayload": {
      "type": "object",
      "required": [
        "turn_id",
        "code",
        "message"
      ],
      "properties": {
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "message": {
          "description": "Short, plain, user-facing text.",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "LlmState": {
      "type": "string",
      "enum": [
        "unloaded",
        "loading",
        "ready",
        "failed"
      ]
    },
    "LlmStatusPayload": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/LlmState"
        },
        "model": {
          "$ref": "#/$defs/ModelName"
        },
        "detail": {
          "description": "User-facing explanation when failed.",
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "ChatSendMessage": {
      "description": "Rust -> core. Start a turn; the message id becomes the turn id. A newer chat.send cancels a running turn.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "chat.send"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/ChatSendPayload"
        }
      }
    },
    "ChatCancelMessage": {
      "description": "Rust -> core. Stop a running turn; core still sends chat.done with cancelled = true.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "chat.cancel"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/ChatCancelPayload"
        }
      }
    },
    "ChatResetMessage": {
      "description": "Rust -> core. Start a new chat: cancel any running turn and clear the conversation history (F-414).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "chat.reset"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/EmptyPayload"
        }
      }
    },
    "ChatStartedMessage": {
      "description": "core -> Rust. A turn began.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "chat.started"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/ChatStartedPayload"
        }
      }
    },
    "ChatDeltaMessage": {
      "description": "core -> Rust. Streamed reply text.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "chat.delta"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/ChatDeltaPayload"
        }
      }
    },
    "ChatToolMessage": {
      "description": "core -> Rust. A tool step changed state.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "chat.tool"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/ChatToolPayload"
        }
      }
    },
    "ChatDoneMessage": {
      "description": "core -> Rust. A turn ended normally or was cancelled.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "chat.done"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/ChatDonePayload"
        }
      }
    },
    "ChatFailedMessage": {
      "description": "core -> Rust. A turn ended with an error.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "chat.failed"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/ChatFailedPayload"
        }
      }
    },
    "LlmStatusMessage": {
      "description": "core -> Rust. Model load state changed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "llm.status"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/LlmStatusPayload"
        }
      }
    },
    "SettingNav": {
      "description": "Settings section (CLAUDE.md §6.5).",
      "type": "string",
      "enum": [
        "general",
        "voice",
        "models",
        "personality",
        "appearance",
        "hotkeys",
        "permissions",
        "memory",
        "routines",
        "web",
        "advanced",
        "diagnostics",
        "about"
      ]
    },
    "SettingValue": {
      "type": [
        "boolean",
        "integer",
        "string"
      ]
    },
    "SettingName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "SettingItem": {
      "type": "object",
      "required": [
        "section",
        "key",
        "nav",
        "label",
        "description",
        "kind",
        "default",
        "value"
      ],
      "properties": {
        "section": {
          "$ref": "#/$defs/SettingName"
        },
        "key": {
          "$ref": "#/$defs/SettingName"
        },
        "nav": {
          "$ref": "#/$defs/SettingNav"
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "kind": {
          "type": "string",
          "enum": [
            "boolean",
            "choice",
            "integer",
            "text"
          ]
        },
        "default": {
          "$ref": "#/$defs/SettingValue"
        },
        "value": {
          "$ref": "#/$defs/SettingValue"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        },
        "unit": {
          "description": "Unit shown after integer values, such as px, ms, min or tokens.",
          "type": "string",
          "maxLength": 16
        },
        "widget": {
          "description": "Control the Settings window draws instead of the plain one for its kind (F-415). Absent: the plain control.",
          "type": "string",
          "enum": [
            "model",
            "folder",
            "shortcut",
            "slider"
          ]
        },
        "role": {
          "description": "For widget = model: which model role the setting chooses (small, default or large).",
          "type": "string",
          "enum": [
            "small",
            "default",
            "large"
          ]
        },
        "steps": {
