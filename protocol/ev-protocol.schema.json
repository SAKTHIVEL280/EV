{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SAKTHIVEL280/EV/blob/main/protocol/ev-protocol.schema.json",
  "title": "EvMessage",
  "description": "EV wire protocol between the Tauri app (Rust) and ev-core (Python). One JSON object per WebSocket text frame. Changes are additive; removing or renaming a field requires a protocol version bump.",
  "x-ev-protocol-version": 1,
  "oneOf": [
    {
      "$ref": "#/$defs/HelloMessage"
    },
    {
      "$ref": "#/$defs/HelloAckMessage"
    },
    {
      "$ref": "#/$defs/PingMessage"
    },
    {
      "$ref": "#/$defs/PongMessage"
    },
    {
      "$ref": "#/$defs/ErrorMessage"
    },
    {
      "$ref": "#/$defs/ShutdownMessage"
    }
  ],
  "$defs": {
    "ProtocolVersion": {
      "description": "Protocol version of the sender. Receivers compare it with their own and reply with an error of code protocol_mismatch when they differ.",
      "type": "integer",
      "minimum": 1
    },
    "MessageId": {
      "description": "UUID v4, unique per message.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Version": {
      "description": "Semantic version string of a component.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "ModuleState": {
      "type": "string",
      "enum": [
        "starting",
        "ready",
        "disabled",
        "failed"
      ]
    },
    "ModuleStatus": {
      "type": "object",
      "required": [
        "name",
        "state"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "state": {
          "$ref": "#/$defs/ModuleState"
        },
        "detail": {
          "description": "User-facing explanation when state is disabled or failed.",
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "HelloPayload": {
      "type": "object",
      "required": [
        "app_version",
        "protocol"
      ],
      "properties": {
        "app_version": {
          "$ref": "#/$defs/Version"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion"
        }
      }
    },
    "HelloAckPayload": {
      "type": "object",
      "required": [
        "core_version",
        "protocol",
        "modules"
      ],
      "properties": {
        "core_version": {
          "$ref": "#/$defs/Version"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleStatus"
          }
        }
      }
    },
    "EmptyPayload": {
      "type": "object"
    },
    "ErrorPayload": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "description": "Stable machine-readable code. New codes may be added; receivers treat unknown codes as internal.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "message": {
          "description": "Short, plain, user-facing text.",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "detail": {
          "description": "Technical detail for logs. Never shown in the island.",
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "ShutdownPayload": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "app_exit",
            "restart"
          ]
        }
      }
    },
    "HelloMessage": {
      "description": "Rust -> core. First message after the WebSocket opens.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "hello"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/HelloPayload"
        }
      }
    },
    "HelloAckMessage": {
      "description": "core -> Rust. Answer to hello.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "hello.ack"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/HelloAckPayload"
        }
      }
    },
    "PingMessage": {
      "description": "Rust -> core. Liveness check, sent every 5 s.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "ping"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/EmptyPayload"
        }
      }
    },
    "PongMessage": {
      "description": "core -> Rust. Answer to ping; reply_to carries the ping id.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "pong"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/EmptyPayload"
        }
      }
    },
    "ErrorMessage": {
      "description": "Either direction. reply_to carries the id of the message that caused it, when known.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "error"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/ErrorPayload"
        }
      }
    },
    "ShutdownMessage": {
      "description": "Rust -> core. Core stops modules, closes the socket and exits with code 0.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "payload"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "const": "shutdown"
        },
        "id": {
          "$ref": "#/$defs/MessageId"
        },
        "reply_to": {
          "$ref": "#/$defs/MessageId"
        },
        "payload": {
          "$ref": "#/$defs/ShutdownPayload"
        }
      }
    }
  }
}
